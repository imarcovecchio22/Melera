generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pendiente
  pagado
  en_preparacion
  enviado
  entregado
  cancelado
}

model Product {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String
  precio      Int
  stock       Int      @default(0)
  imagenUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

model Order {
  id        String      @id @default(cuid())
  numero    Int         @default(autoincrement())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Datos del cliente
  nombre    String
  apellido  String
  email     String
  telefono  String

  // Dirección de entrega
  calle       String
  numero_dir  String
  pisoDepto   String?
  localidad   String
  provincia   String
  codigoPostal String

  // Detalle del pedido
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  cantidad  Int
  total     Int

  estado      OrderStatus @default(pendiente)
  mpPaymentId String?
  mpPreferenceId String?

  // ?origen= con el que llegó a /producto (ej: "instagram" desde ManyChat)
  origen String?

  @@index([estado])
  @@index([mpPreferenceId])
}

enum CanalRespuesta {
  instagram
  email
}

enum ConsultaEstado {
  nueva
  respondida
  archivada
}

model Consulta {
  id        Int            @id @default(autoincrement())
  nombre    String
  canal     CanalRespuesta
  instagram String? // siempre con @ adelante
  email     String?
  mensaje   String
  origen    String? // ?origen= de la URL (ej: "instagram" desde ManyChat)
  estado    ConsultaEstado @default(nueva)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([estado, createdAt])
}

enum LogNivel {
  info
  warn
  error
}

// Registro de eventos de la web (se ve en /admin/logs)
model EventLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  nivel     LogNivel @default(info)
  tipo      String // pedido, pago, consulta, telegram, admin, imagen
  mensaje   String
  detalle   Json?

  @@index([createdAt])
  @@index([nivel, createdAt])
  @@index([tipo, createdAt])
}

enum TipoPostIG {
  presentacion
  producto
  dato
}

enum EstiloPostIG {
  organico
  geo
}

enum EstadoPostIG {
  pendiente
  generando
  esperando_aprobacion
  publicando
  publicado
  descartado
  error
}

enum DestinoPostIG {
  feed
  story
  both
}

// Cronograma de Instagram (reemplaza la Google Sheet "Cronograma" y los escenarios de Make)
model PostIG {
  id     Int          @id @default(autoincrement())
  fecha  DateTime     @db.Date // día desde el que se puede generar
  tipo   TipoPostIG
  estilo EstiloPostIG
  tema   String

  // Solo para tipo producto (datos reales que carga el admin)
  nombreProducto String?
  categoria      String?
  precio         String?
  presentacion   String?
  imagenUrl      String?

  estado  EstadoPostIG @default(pendiente)
  copy    Json? // textos que escribió Gemini (tagline, titulo, etc.)
  caption String?
  feedUrl  String?
  storyUrl String?

  destino           DestinoPostIG?
  feedMediaId       String?
  storyMediaId      String?
  telegramMessageId Int?
  error             String?

  generadoEn  DateTime?
  publicadoEn DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([estado, fecha])
}
