generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pendiente
  pagado
  en_preparacion
  enviado
  entregado
  cancelado
}

model Product {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String
  precio      Int
  stock       Int      @default(0)
  imagenUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

model Order {
  id        String      @id @default(cuid())
  numero    Int         @default(autoincrement())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Datos del cliente
  nombre    String
  apellido  String
  email     String
  telefono  String

  // Dirección de entrega
  calle       String
  numero_dir  String
  pisoDepto   String?
  localidad   String
  provincia   String
  codigoPostal String

  // Detalle del pedido
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  cantidad  Int
  total     Int

  estado      OrderStatus @default(pendiente)
  mpPaymentId String?
  mpPreferenceId String?

  @@index([estado])
  @@index([mpPreferenceId])
}

enum CanalRespuesta {
  instagram
  email
}

enum ConsultaEstado {
  nueva
  respondida
  archivada
}

model Consulta {
  id        Int            @id @default(autoincrement())
  nombre    String
  canal     CanalRespuesta
  instagram String? // siempre con @ adelante
  email     String?
  mensaje   String
  origen    String? // ?origen= de la URL (ej: "instagram" desde ManyChat)
  estado    ConsultaEstado @default(nueva)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([estado, createdAt])
}
